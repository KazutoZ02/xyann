# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# NVIDIA NIM API Key (Get from https://build.nvidia.com/)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here

# GitHub Personal Access Token (Requires 'repo' scope permissions)
GITHUB_TOKEN=ghp_your_github_token_here

# Render Free Tier Web App URL (for auto-ping self keep-alive)
# Example: https://your-app-name.onrender.com
RENDER_URL=

# Port for embedded web server (Render defaults to 8080 or PORT env var)
PORT=8080
